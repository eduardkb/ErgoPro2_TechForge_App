# =============================================================================
# ErgoPro2 - .gitignore
#
# Only source code, build scripts, resources and documentation are committed.
# Everything that is generated by CMake/Qt/compilers/packaging tools or that is
# specific to a developer's machine or IDE is excluded here.
#
# NOTE: resources/icons/app/ErgoPro2.icns, ErgoPro2.ico and ergopro2.png ARE
# committed on purpose (the build needs them; regenerate with
# scripts/generate-icons.sh). Do not add rules that ignore them.
# =============================================================================

# -----------------------------------------------------------------------------
# Build folders (any name used in documentation/BUILD.md and by IDEs)
# -----------------------------------------------------------------------------
/build/
/build-*/
/build_*/
/cmake-build-*/
/out/
/bin/
/lib/
/Debug/
/Release/
/RelWithDebInfo/
/MinSizeRel/
/x64/
/x86/
/ARM64/

# Packaging output (dist folder, installers, archives, disk images)
/dist/
/package/
/_CPack_Packages/
*.dmg
*.deb
*.rpm
*.msi
*.msix
*.pkg
*.AppImage
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# -----------------------------------------------------------------------------
# CMake generated files (in case of an accidental in-source build)
# -----------------------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
CPackConfig.cmake
CPackSourceConfig.cmake
DartConfiguration.tcl
Testing/
_deps/
build.ninja
.ninja_deps
.ninja_log
rules.ninja
Makefile
compile_commands.json
CMakeUserPresets.json

# -----------------------------------------------------------------------------
# Qt generated files (moc / uic / rcc / translations / Qt Creator)
# -----------------------------------------------------------------------------
*_autogen/
moc_*.cpp
moc_*.h
moc_predefs.h
*.moc
qrc_*.cpp
ui_*.h
*.qm
.qmake.cache
.qmake.stash
*.pro.user
*.pro.user.*
*.qbs.user
*.qbs.user.*
CMakeLists.txt.user*
.qtcreator/
.qtc_clangd/

# -----------------------------------------------------------------------------
# Compiler / linker output
# -----------------------------------------------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp
*.idb
*.res
*.gch
*.pch
*.dSYM/
*.app/

# -----------------------------------------------------------------------------
# IDEs and editors
# -----------------------------------------------------------------------------
# Visual Studio Code
.vscode/
*.code-workspace
# JetBrains (CLion)
.idea/
# Visual Studio
.vs/
*.user
*.suo
*.sln.docstates
*.VC.db
*.VC.opendb
# Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
# clangd / ccls / other tooling caches
.cache/
.clangd/
.ccls-cache/
# Vim / Emacs / misc editors
*.swp
*.swo
*~
\#*\#
.\#*
*.orig
*.rej
*.bak
*.tmp

# -----------------------------------------------------------------------------
# Operating system files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
# Linux
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# Runtime / local data (never part of the source)
# -----------------------------------------------------------------------------
*.log
settings.json
settings.corrupt-*.json
*.lock

# Local environment / secrets (code signing identities, tokens)
.env
.env.*
*.p12
*.pfx
*.cer
*.mobileprovision

# Local AI assistant / tool settings
.claude/settings.local.json
